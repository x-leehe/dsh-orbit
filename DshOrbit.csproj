<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DSH-Orbit</AssemblyName>
    <Product>DSH-Orbit</Product>
    <AssemblyTitle>DSH-Orbit</AssemblyTitle>
    <!-- 版本：安装器与「应用和功能」里的 DisplayVersion 都从这里读 -->
    <Version>0.2.1</Version>
    <FileVersion>0.2.1.0</FileVersion>
    <InformationalVersion>0.2.1</InformationalVersion>
    <Company>DSH-Orbit</Company>
    <RootNamespace>DshOrbit</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- 可空引用警告当错误处理：WebView2 的 View/Core 生命周期很容易写出空的解引用 -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- WebView2 包一并带了 WPF 程序集，它会和 WindowsBase 版本冲突（我们只用 WinForms，不引用 WPF）。
         这是包层面的提示，不是代码问题，降级为消息避免噪声。 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>


  <ItemGroup>
    <!-- 搜索引擎品牌图标（lucide 没有品牌 logo，单独嵌入 favicon） -->
    <EmbeddedResource Include="assets\engines\*.png" LogicalName="engines.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ 下是独立的冒烟测试工程，不编进挂件本体 -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="launcher\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <!-- installer/ 是独立的安装器工程，不能编进主程序（否则多入口点） -->
    <Compile Remove="installer\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="launcher\**\*" />
    <EmbeddedResource Remove="tools\**\*" />
    <EmbeddedResource Remove="installer\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="launcher\**\*" />
    <None Remove="tools\**\*" />
    <None Remove="installer\**\*" />
  </ItemGroup>

</Project>
