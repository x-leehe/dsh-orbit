<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DshOrbit</RootNamespace>
    <AssemblyName>Harness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Models.cs" />
    <Compile Include="..\..\ConfigStore.cs" />
    <Compile Include="..\..\ChinaHolidays.cs" />
    <Compile Include="..\..\DshServices.cs" />
    <Compile Include="..\..\Native.cs" />
    <Compile Include="..\..\Balance.cs" />
    <!-- Models.cs 的状态色与 Fluent 令牌同源；Fluent 的按钮/图标又依赖 Icons 与官方几何。 -->
    <Compile Include="..\..\Fluent.cs" />
    <Compile Include="..\..\Icons.cs" />
    <Compile Include="..\..\LucideData.cs" />
    <Compile Include="..\..\SvgPath.cs" />
  </ItemGroup>

</Project>
